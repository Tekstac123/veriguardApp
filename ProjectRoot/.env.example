# VeriGuard — copy to .env (never commit .env). Comments go on their own line; define each variable once.
# offline = graded, no Azure (default) · live = Azure + Foundry from VS Code
VERIGUARD_MODE=offline

# ---- Week 1 · LLM gateway — every answer the model writes goes through here (used for running AND evaluation)
# TODO [W1-T0] paste the key you were given. Never put it in code, never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llmgateway-lms.tekstac.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
# gateway (answers by the gateway model) · extractive (no model call) · azure (gpt-4.1-mini on your Foundry, live only)
VERIGUARD_LLM=gateway

# ---- Week 1 · subscription and identity
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_TENANT_ID=
# ---- Week 1 · Microsoft Foundry (project Overview page; resource Keys and Endpoint page for the two endpoints)
FOUNDRY_RESOURCE_NAME=veriguard-foundry
AZURE_AI_PROJECT_ENDPOINT=https://veriguard-foundry.services.ai.azure.com/api/projects/proj-veriguard
AZURE_OPENAI_ENDPOINT=https://veriguard-foundry.openai.azure.com
AZURE_AI_SERVICES_ENDPOINT=https://veriguard-foundry.cognitiveservices.azure.com
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
# project resource → JSON View → Resource ID
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/veriguard-foundry/projects/proj-veriguard
# ---- Week 1 · Blob Storage and Azure AI Search
AZURE_STORAGE_ACCOUNT=veriguardcorpus
AZURE_SEARCH_ENDPOINT=https://veriguard-search.search.windows.net
AZURE_SEARCH_INDEX=veriguard-m1

# ---- Week 2 · Key Vault, MCP server, project connection
AZURE_KEY_VAULT_NAME=veriguard-kv
VERIGUARD_MCP_URL=https://<veriguard-tools-mcp fqdn>/mcp
VERIGUARD_MCP_CONNECTION=veriguard-tools-mcp
# local MCP test only — in Azure the key comes from Key Vault (secret veriguard-mcp-api-key)
MCP_API_KEY=
ACR_NAME=veriguardacr
CONTAINERAPPS_ENV=veriguard-env
LOCATION=southindia

# ---- Week 3 · Microsoft Entra ID (app registration veriguard-api)
VERIGUARD_API_AUDIENCE=api://veriguard-api
# security-group object ids (Entra ID → Groups → Object ID); optional when app roles are assigned directly
ENTRA_GROUP_ANALYST=
ENTRA_GROUP_INVESTIGATOR=
ENTRA_GROUP_AUDITOR=
ENTRA_GROUP_PRINCIPALOFFICER=
ENTRA_GROUP_ADMIN=

# ---- Week 4 · observability and the deployed API
APPLICATIONINSIGHTS_CONNECTION_STRING=
VERIGUARD_API_URL=https://<veriguard-api fqdn>
