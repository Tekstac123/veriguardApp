{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DCB Suspicious Transaction Report - Draft (synthetic FIU-style template)",
  "type": "object",
  "required": [
    "report_ref",
    "case_id",
    "subject",
    "accounts",
    "transactions_summary",
    "grounds_of_suspicion",
    "typologies",
    "citations",
    "approval",
    "ai_assistance"
  ],
  "properties": {
    "report_ref": {
      "type": "string",
      "pattern": "^STR-DCB-2026-\\d{4}$"
    },
    "case_id": {
      "type": "string",
      "description": "Alert ID, e.g. ALR-2026-0417"
    },
    "reporting_entity": {
      "type": "string",
      "const": "Deccan Commonwealth Bank"
    },
    "subject": {
      "type": "object",
      "required": [
        "customer_id",
        "name",
        "pan_masked",
        "aadhaar_masked",
        "occupation",
        "risk_category"
      ],
      "properties": {
        "customer_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "pan_masked": {
          "type": "string",
          "pattern": "^[A-Z]{2}X{5}[A-Z0-9]{3}$"
        },
        "aadhaar_masked": {
          "type": "string",
          "pattern": "^XXXX XXXX \\d{4}$"
        },
        "occupation": {
          "type": "string"
        },
        "risk_category": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        }
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "account_number_masked": {
            "type": "string"
          },
          "branch_code": {
            "type": "string"
          }
        }
      }
    },
    "transactions_summary": {
      "type": "object",
      "properties": {
        "period_from": {
          "type": "string",
          "format": "date"
        },
        "period_to": {
          "type": "string",
          "format": "date"
        },
        "count": {
          "type": "integer"
        },
        "total_value_inr": {
          "type": "number"
        },
        "key_transaction_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "grounds_of_suspicion": {
      "type": "string",
      "minLength": 100
    },
    "typologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_score": {
      "type": "object",
      "properties": {
        "score": {
          "type": "integer"
        },
        "band": {
          "enum": [
            "Low",
            "Medium",
            "High"
          ]
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attempted_transaction": {
      "type": "boolean"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "version",
          "section"
        ],
        "properties": {
          "doc_id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "section": {
            "type": "string"
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING_PO_APPROVAL",
            "APPROVED",
            "REJECTED"
          ]
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "ai_assistance": {
      "type": "object",
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "trace_id": {
          "type": "string"
        }
      }
    }
  }
}